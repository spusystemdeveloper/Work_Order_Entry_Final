<Window x:Class="DVO_STORE_DB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Order Entry_V8 - Modern Windows 11" Height="760" Width="1360"
        Background="#F3F3F3" FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Top Customer Card -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Customer: " Foreground="#605E5C" FontSize="12"/>
                        <TextBlock Text="BARANGAY GOVERNMENT OF MAA [F8]" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Payment Type:" Foreground="#605E5C" FontSize="12"/>
                        <TextBlock Text="CHARGE" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sales Rep:" Foreground="#605E5C" FontSize="12"/>
                        <TextBlock Text="WALK-IN [F7]" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Release Type:" Foreground="#605E5C" FontSize="12"/>
                        <RadioButton Content="Pick-up" IsChecked="True" Margin="8,0,0,0" FontSize="12"/>
                        <RadioButton Content="Delivery" Margin="12,0,0,0" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inventory DataGrid Card -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,12,0,0" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="DgvInventory" AutoGenerateColumns="False" CanUserAddRows="False" 
                      AlternatingRowBackground="#FBFBFB" SelectionMode="Single" SelectionUnit="FullRow"
                      MouseDoubleClick="DgvInventory_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ITEM CODE" Binding="{Binding Code}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                                <Setter Property="Padding" Value="12,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="ITEM PRICE" Binding="{Binding Price}" Width="100"/>
                    <DataGridTextColumn Header="AVAIL QTY" Binding="{Binding Avail}" Width="100"/>
                    <DataGridTextColumn Header="SOH" Binding="{Binding Soh}" Width="90"/>
                    <DataGridTextColumn Header="QTY COM" Binding="{Binding QtyCom}" Width="90"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Bottom Area -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Selected Items -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#F9F9F9" CornerRadius="8,8,0,0" Padding="12,0">
                        <TextBlock Text="SELECTED ITEMS - 1 item" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#605E5C"/>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="DgvSelected" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM CODE" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="ITEM NAME" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="QUANTITY" Binding="{Binding Qty}" Width="80"/>
                            <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" Width="90"/>
                            <DataGridTextColumn Header="TOTAL PRICE" Binding="{Binding Total}" Width="110"/>
                            <DataGridTextColumn Header="LAST PURCHASE PRICE" Binding="{Binding Last}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Totals Card - like web -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="TOTALS" FontSize="11" FontWeight="SemiBold" Foreground="#8A8886" Margin="0,0,0,12"/>
                    <Border Background="#F9F9F9" CornerRadius="4" Padding="12,8" Margin="0,0,0,8" BorderBrush="#F3F3F3" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Sub Total" Foreground="#605E5C" FontSize="12"/>
                            <TextBlock x:Name="TxtSub" Text="₱ 982.14" HorizontalAlignment="Right" FontFamily="Cascadia Mono" FontSize="12"/>
                        </Grid>
                    </Border>
                    <Border Background="#F9F9F9" CornerRadius="4" Padding="12,8" Margin="0,0,0,8" BorderBrush="#F3F3F3" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="VAT (12%)" Foreground="#605E5C" FontSize="12"/>
                            <TextBlock x:Name="TxtVat" Text="₱ 117.86" HorizontalAlignment="Right" FontFamily="Cascadia Mono" FontSize="12"/>
                        </Grid>
                    </Border>
                    <Border Background="#1A1A1A" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Total" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotal" Text="₱ 1,100.00" Foreground="White" HorizontalAlignment="Right" FontFamily="Cascadia Mono" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8A8886" Margin="0,0,0,16">
                        VAT-exclusive: ₱ 982.14 • VATable Sales: ₱ 982.14 • Zero Rated 0.00
                        <LineBreak/>Suggested W/Tax: ₱ 11.00
                    </TextBlock>
                    <Button x:Name="BtnSave" Content="Save [F12]" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Recall [F11]" Grid.Column="0" Margin="0,0,4,0" Height="32"/>
                        <Button Content="Remove [Del]" Grid.Column="1" Margin="4,0,0,0" Height="32"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Cancel [F9]" Grid.Column="0" Margin="0,0,4,0" Height="32"/>
                        <Button Content="Close [Esc]" Grid.Column="1" Margin="4,0,0,0" Height="32"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Margin="-12,12,-12,-12" Padding="12,0">
            <TextBlock x:Name="TxtStatus" Text="SERVER localhost | DATABASE DVO_STORE_DB | Register: 1 | User: Administrator | 1 item(s) selected | 14 items" 
                       VerticalAlignment="Center" FontSize="11" Foreground="#605E5C"/>
        </Border>
    </Grid>
</Window>
